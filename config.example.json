{
  "_comment": "复制本文件为 config.json 后使用。jev 为单步决策后端配置，支持两种服务（按 key 前缀自动识别，endpoint 必须与服务匹配）：(1) Nace：endpoint=https://console.nace.ai/v1/systemone，model=drex-v1.5，key 前缀 nace_sk_，国内网络可直连；(2) TypeSafe：endpoint=https://api.typesafe.ai/v1/systemone，model=jev-latest，key 前缀 apikey_。api_keys 为主备列表，遇 401/403/额度类错误按序轮换，全部失效自动降级规则引擎。backend 取 api/local/off。",
  "device": {
    "serial": "127.0.0.1:55556",
    "adb_path": "adb"
  },
  "tasks": {
    "max_searches": 30,
    "watchdog_minutes": 45
  },
  "delays": {
    "click": [
      1.5,
      4.0
    ],
    "page_load": [
      2.0,
      6.0
    ],
    "between_tasks": [
      20,
      90
    ],
    "dwell_search": [
      6,
      14
    ],
    "dwell_activity": [
      15,
      40
    ],
    "dwell_read": [
      20,
      50
    ],
    "dwell_quiz": [
      30,
      60
    ]
  },
  "human": {
    "start_jitter_minutes": 25,
    "zoneout_prob": 0.07,
    "tap_jitter_px": 30
  },
  "jev": {
    "backend": "api",
    "endpoint": "https://console.nace.ai/v1/systemone",
    "model": "drex-v1.5",
    "timeout_s": 15,
    "api_keys": [
      "nace_sk_替换为你的key"
    ]
  },
  "local_model": {
    "enabled_auto": true,
    "name": "Qwen/Qwen2.5-0.5B"
  }
}